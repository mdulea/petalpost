{
  "name": "petalpost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "serve --listen 3000 --no-clipboard",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "node scripts/check-contrast.js && node scripts/check-invite.js && node scripts/check-site.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "serve": "14.2.7",
    "typescript": "7.0.2"
  }
}
