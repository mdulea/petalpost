{
  "name": "petalpost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "serve --listen 3000 --no-clipboard",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "pnpm format:check && pnpm lint && node --test scripts/check-*.js",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "serve": "14.2.7",
    "typescript": "7.0.2",
    "vercel": "65.15.0"
  }
}
