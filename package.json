{
  "name": "petalpost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "pnpm check:fast && pnpm test:browser",
    "check:fast": "pnpm test && pnpm typecheck",
    "dev": "node scripts/server.js --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "migrate": "node server/migrate.js",
    "pages": "node scripts/pages.js",
    "typecheck": "tsc -p .",
    "test": "pnpm format:check && pnpm lint && node --test tests/check-*.js",
    "test:browser": "playwright test",
    "worktree": "node scripts/worktree.js"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/emscripten": "1.41.6",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
